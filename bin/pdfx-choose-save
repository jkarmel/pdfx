#!/usr/bin/env python3
"""Open the desktop portal's Save File dialog and print the chosen path.

Uses org.freedesktop.portal.FileChooser, so whichever chooser the user has
registered (Strata, GTK, ...) provides the dialog. Prints nothing and exits 1
when the user cancels.
"""
import os, sys, urllib.parse
import gi
gi.require_version("Gio", "2.0")
gi.require_version("GLib", "2.0")
from gi.repository import Gio, GLib


def main():
    folder = sys.argv[1] if len(sys.argv) > 1 else os.getcwd()
    name = sys.argv[2] if len(sys.argv) > 2 else "document.pdf"
    title = sys.argv[3] if len(sys.argv) > 3 else "Save PDF"
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    sender = bus.get_unique_name()[1:].replace(".", "_")
    token = f"pdfx{os.getpid()}"
    request_path = f"/org/freedesktop/portal/desktop/request/{sender}/{token}"
    loop = GLib.MainLoop()
    result = {"path": None}

    def on_response(_conn, _sender, _path, _iface, _signal, params):
        code, results = params.unpack()
        if code == 0:
            uris = results.get("uris") or []
            if uris:
                parsed = urllib.parse.urlparse(uris[0])
                result["path"] = urllib.parse.unquote(parsed.path)
        loop.quit()

    bus.signal_subscribe("org.freedesktop.portal.Desktop", "org.freedesktop.portal.Request", "Response",
                         request_path, None, Gio.DBusSignalFlags.NONE, on_response)
    options = {
        "handle_token": GLib.Variant("s", token),
        "current_name": GLib.Variant("s", name),
        "current_folder": GLib.Variant("ay", folder.encode() + b"\0"),
        "filters": GLib.Variant("a(sa(us))", [("PDF", [(0, "*.pdf")])]),
    }
    try:
        bus.call_sync("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop",
                      "org.freedesktop.portal.FileChooser", "SaveFile",
                      GLib.Variant("(ssa{sv})", ("", title, options)),
                      GLib.VariantType("(o)"), Gio.DBusCallFlags.NONE, -1, None)
    except GLib.Error as error:
        print(f"pdfx-choose-save: {error.message}", file=sys.stderr)
        return 2
    GLib.timeout_add_seconds(600, loop.quit)
    loop.run()
    if not result["path"]:
        return 1
    print(result["path"])
    return 0


if __name__ == "__main__":
    sys.exit(main())
